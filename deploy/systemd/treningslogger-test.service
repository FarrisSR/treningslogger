[Unit]
Description=Treningslogger Test Flask App (Gunicorn)
After=network.target

[Service]
User=runo
Group=runo
WorkingDirectory=/opt/test-treningslogger
EnvironmentFile=/opt/test-treningslogger/.env
Environment=MPLCONFIGDIR=/run/treningslogger-test
RuntimeDirectory=treningslogger-test
ExecStart=/opt/test-treningslogger/.venv/bin/gunicorn -c gunicorn.conf.py run:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
